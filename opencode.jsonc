{
  "$schema": "https://opencode.ai/config.json",
  // Optional Context7 MCP example for current documentation research.
  // Set CONTEXT7_API_KEY in your environment if your Context7 account requires it.
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["npx", "-y", "shadcn@latest", "mcp"],
      "enabled": false
    },
    "neon": {
      "type": "remote",
      "url": "https://mcp.neon.tech/mcp",
      "enabled": true
    }
  },
  "instructions": [
    "AGENTS.md",
    "docs/agents/rules/typescript.md",
    "docs/agents/rules/ui.md",
    "docs/agents/rules/i18n.md",
    "docs/agents/rules/server-functions.md",
    "docs/agents/rules/database.md",
    "docs/agents/rules/auth.md",
    "docs/agents/rules/verification.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  }
}
