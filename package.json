{
  "name": "pabriq-app-v2",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3001\"",
    "dev:infisical": "bun run load-env -- bun run dev",
    "dev:agent": "bash scripts/infisical-run.sh bun run dev",
    "db:studio:infisical": "bun run load-env -- bun run db:studio",
    "db:studio:agent": "bash scripts/infisical-run.sh bun run db:studio",
    "build": "vite build && cp instrument.server.mjs dist/server && bun build src/db/migrate.ts --outfile=dist/migrate.js --target=node",
    "preview": "vite preview",
    "test": "NODE_ENV=test VITEST_FROM_SCRIPT=true bun --env-file=.env.test x vitest run --passWithNoTests",
    "test:e2e": "NODE_ENV=test bun --env-file=.env.test x playwright test",
    "test:e2e:headed": "NODE_ENV=test bun --env-file=.env.test x playwright test --headed",
    "test:e2e:debug": "NODE_ENV=test bun --env-file=.env.test x playwright test --debug=cli",
    "check": "biome check .",
    "load-env": "infisical run --env=dev --projectId=40d6476c-55e5-4e1b-8079-b251009c6772",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "start": "srvx serve --prod --import ./dist/server/instrument.server.mjs --entry ./dist/server/server.js -s ../client",
    "start:prod": "node scripts/start-production.mjs",
    "bootstrap:owner": "bun run scripts/bootstrap-owner.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "mastra:dev": "mastra dev",
    "mastra:build": "mastra build",
    "telegram:webhook:set": "bun run scripts/telegram-webhook-set.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.35",
    "@assistant-ui/react": "^0.14.27",
    "@assistant-ui/react-ai-sdk": "^1.3.41",
    "@assistant-ui/react-markdown": "^0.14.6",
    "@assistant-ui/react-streamdown": "^0.3.6",
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@mastra/ai-sdk": "^1.6.2",
    "@mastra/core": "^1.47.0",
    "@mastra/loggers": "^1.2.0",
    "@mastra/memory": "^1.21.2",
    "@mastra/pg": "^1.14.2",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/tanstackstart-react": "^10.42.0",
    "@serwist/window": "^9.5.11",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-pacer": "^0.22.0",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^7.0.32",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "js-cookie": "^3.0.5",
    "lucide-react": "^1.14.0",
    "midtrans-client": "^1.4.3",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dropzone": "^15.0.0",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "serwist": "^9.5.11",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.12",
    "use-intl": "^4.11.0",
    "vaul": "^1.1.2",
    "vite-plugin-neon-new": "^0.8.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@playwright/test": "^1.61.1",
    "@serwist/build": "^9.5.11",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-cookie": "^3.0.6",
    "@types/midtrans-client": "^1.4.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.5.2",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^18.0.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  },
  "pnpm": {
    "overrides": {}
  }
}
