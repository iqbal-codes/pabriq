{
  "name": "pabriq-app-v2",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3001\"",
    "dev:infisical": "bun run load-env -- bun run dev",
    "dev:agent": "bash scripts/infisical-run.sh bun run dev",
    "db:studio:infisical": "bun run load-env -- bun run db:studio",
    "db:studio:agent": "bash scripts/infisical-run.sh bun run db:studio",
    "build": "vite build && cp instrument.server.mjs dist/server",
    "preview": "vite preview",
    "test": "bun run load-env-test -- vitest run --passWithNoTests",
    "test:e2e": "bun run load-env-test -- playwright test",
    "test:e2e:headed": "bun run load-env-test -- playwright test --headed",
    "test:e2e:debug": "bun run load-env-test -- playwright test --debug=cli",
    "check": "biome check .",
    "load-env": "infisical run --env=dev --projectId=40d6476c-55e5-4e1b-8079-b251009c6772",
    "load-env-test": "infisical run --env=staging --projectId=40d6476c-55e5-4e1b-8079-b251009c6772",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "start": "node --import ./dist/server/instrument.server.mjs dist/server/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "bun run load-env -- drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "mastra:dev": "mastra dev",
    "mastra:build": "mastra build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@mastra/core": "^1.47.0",
    "@mastra/loggers": "^1.2.0",
    "@mastra/memory": "^1.21.2",
    "@mastra/pg": "^1.14.2",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/tanstackstart-react": "^10.42.0",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-pacer": "^0.22.0",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.5.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "js-cookie": "^3.0.5",
    "lucide-react": "^1.14.0",
    "midtrans-client": "^1.4.3",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.0",
    "react-dropzone": "^15.0.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "use-intl": "^4.11.0",
    "vaul": "^1.1.2",
    "vite-plugin-neon-new": "^0.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-cookie": "^3.0.6",
    "@types/midtrans-client": "^1.4.0",
    "@types/node": "^25.6.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "happy-dom": "^20.9.0",
    "mastra": "^1.16.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
