# These will be automatically created by Neon Launchpad (https://neon.new).
# Use pooled URLs for serverless deployment when available.
DATABASE_URL=
DATABASE_URL_POOLER=
NEON_LAUNCHPAD_DISABLED=false

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
COOKIE_DOMAIN=.localhost
TRUSTED_ORIGINS=http://localhost:3000

# Feature flags
VITE_ENABLE_ORGANIZATIONS=true

# Sentry monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Biteship
BITESHIP_API_KEY=

# R2 Storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
