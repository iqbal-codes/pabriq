# Postgres connection string. For Dokploy Postgres, use the internal service hostname
# and database credentials from Dokploy.
DATABASE_URL=

# Optional: pooled URL for serverless drivers (not required for self-hosted Postgres)
DATABASE_URL_POOLER=

# Disable Neon Launchpad when using Dokploy/self-hosted Postgres.
NEON_LAUNCHPAD_DISABLED=true

# Better Auth — set BETTER_AUTH_URL, COOKIE_DOMAIN, and TRUSTED_ORIGINS for app + subdomains.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://<production-domain>
COOKIE_DOMAIN=<root domain without protocol, e.g. pabriq.com>
TRUSTED_ORIGINS=https://<production-domain>,https://operator.<production-domain>,https://portal.<production-domain>

# Feature flags
VITE_ENABLE_ORGANIZATIONS=true

# Logging
LOG_LEVEL=info

# Sentry monitoring — VITE_SENTRY_DSN is read by instrument.server.mjs.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Biteship
BITESHIP_API_KEY=

# R2 Storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=


# Mastra AI assistant (via OpenRouter)
# Format: openrouter/<provider>/<model>
# Examples: openrouter/openai/gpt-4o, openrouter/anthropic/claude-sonnet-4-20250514, openrouter/google/gemini-2.0-flash
# Full model list: https://openrouter.ai/models
MASTRA_MODEL=
OPENROUTER_API_KEY=

# Organization-owned Telegram bots
# Public app origin used to register /api/webhooks/telegram with Telegram.
TELEGRAM_WEBHOOK_BASE_URL=https://<production-domain>
# Secret key material (minimum 32 characters) used to encrypt bot tokens at rest.
TELEGRAM_TOKEN_ENCRYPTION_KEY=

