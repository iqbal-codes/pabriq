{
  "ignoreDependencies": ["pino-pretty", "@react-pdf/types"],
  "dynamicallyLoaded": [
    "src/features/assets/model.ts",
    "src/features/invoices/model.ts",
    "src/features/orders/model.ts",
    "src/features/production/model.ts"
  ],
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "rules": { "unused-exports": "off" }
    },
    {
      "files": ["src/sw.ts", "src/lib/node-polyfills-stub.ts"],
      "rules": { "unused-files": "off" }
    }
  ],
  "health": {
    "ignore": ["src/routeTree.gen.ts"]
  }
}
